# Anjos IA - configuração de exemplo
# Não coloque chaves, tokens ou URLs privadas reais neste arquivo.

DIFY_APP_NAME=IANJOS
DIFY_DSL_VERSION=0.7.0

GEMINI_PROVIDER=langgenius/gemini/google
GEMINI_MODEL=gemini-3.5-flash

DIFY_KNOWLEDGE_DATASET_ID=REPLACE_WITH_DATASET_ID

GOOGLE_APPS_SCRIPT_POST_URL=https://script.google.com/macros/s/REPLACE_WITH_POST_WEB_APP_ID/exec
GOOGLE_APPS_SCRIPT_GET_URL=https://script.google.com/macros/s/REPLACE_WITH_GET_WEB_APP_ID/exec

GOOGLE_SHEETS_SPREADSHEET_ID=REPLACE_WITH_SPREADSHEET_ID
